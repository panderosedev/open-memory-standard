{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://panderose.com/schemas/v1/academic-context.schema.json",
  "title": "AcademicContextPayload",
  "type": "object",
  "required": ["source", "integration_version", "user", "payload"],
  "properties": {
    "source": { "type": "string", "enum": ["canvas_lms", "blackboard", "moodle"] },
    "integration_version": { "type": "string" },
    "user": {
      "type": "object",
      "required": ["external_id", "program_memberships"],
      "properties": {
        "external_id": { "type": "string" },
        "program_memberships": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["type", "assignment_id", "course_code", "title", "due_at", "body_markdown"],
      "properties": {
        "type": { "type": "string", "enum": ["assignment", "announcement", "quiz"] },
        "assignment_id": { "type": "string" },
        "course_code": { "type": "string" },
        "title": { "type": "string" },
        "due_at": { "type": "string", "format": "date-time" },
        "body_markdown": { "type": "string" }
      }
    }
  }
}
